{
  "name": "hack-muc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hackathon Taktile Track — Team LLM",
  "scripts": {
    "dev": "vite",
    "build:api": "node scripts/build-api.mjs",
    "build": "npm run build:api && vite build",
    "preview": "vite preview",
