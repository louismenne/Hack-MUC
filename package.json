    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "proof": "tsx scripts/check-policy-proof.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@elevenlabs/react": "^1.21.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
