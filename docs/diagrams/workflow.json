  "cards": [
    {
      "dot": "emerald",
      "title": "Built and working",
      "items": [
        "Submit saves the claim and its files (login required)",
        "The engine decides with the ACTIVE policy version: rule, reason and version on every decision",
        "A reviewer can override routine or info decisions; saved in the audit log",
        "Policy change: diff and impact, then atomic activation",
        "Open cases are re-evaluated (needs_recheck if the result changes); closed cases keep the original version's decision"
      ]
    },
    {
      "dot": "amber",
      "title": "PLANNED or not connected yet",
      "items": [
        "Saved claims are not evaluated yet: the queue reads sample or uploaded CSV cases",
        "Human-review decisions: the buttons are disabled placeholders",
        "Claimant adds facts: no screen yet, so the loop is not closed",
        "Closing a case has no action yet: status comes from the data",
        "Re-evaluation is computed live in the browser, not stored per case"
      ]
    },
    {
      "dot": "cyan",
      "title": "How to read",
      "items": [
        "Dashed line or PLANNED: not built yet",
        "1, 2, 3: the three possible recommendations"
      ]
    }
  ]
