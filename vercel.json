{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/policy.js": {
      "includeFiles": "data/**"
    },
    "api/policy-ai.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/my-claims",
      "destination": "/index.html"
    },
    {
      "source": "/claim",
      "destination": "/claim/index.html"
    },
    {
      "source": "/review-queue",
      "destination": "/index.html"
    },
    {
      "source": "/examples",
      "destination": "/index.html"
    },
    {
      "source": "/team",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/example-quality",
      "destination": "/index.html"
    },
    {
      "source": "/policy",
      "destination": "/index.html"
    }
  ]
}
